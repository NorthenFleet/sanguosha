{
  "experiment_name": "sanguosha_ai_default",
  "save_dir": "models/experiments",
  "device": "auto",
  "seed": 42,
  
  "ppo": {
    "learning_rate": 3e-4,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_epsilon": 0.2,
    "value_coef": 0.5,
    "entropy_coef": 0.01,
    "max_grad_norm": 0.5,
    "batch_size": 256,
    "mini_batch_size": 64,
    "epochs": 4,
    "state_dim": 512,
    "action_dim": 1000,
    "hidden_dim": 256
  },
  
  "training": {
    "max_episodes": 50000,
    "max_steps_per_episode": 200,
    "eval_interval": 1000,
    "save_interval": 5000,
    "log_interval": 100,
    "num_players": 3,
    "enable_self_play": true
  },
  
  "reward": {
    "survival_weight": 1.0,
    "damage_weight": 0.8,
    "card_advantage_weight": 0.3,
    "equipment_weight": 0.2,
    "strategy_weight": 0.5,
    "efficiency_weight": 0.3,
    "win_reward": 10.0,
    "lose_penalty": -5.0
  },
  
  "self_play": {
    "pool_size": 10,
    "update_interval": 2000,
    "evaluation_games": 100,
    "win_rate_threshold": 0.6,
    "diversity_weight": 0.3
  },
  
  "distributed": {
    "enabled": false,
    "world_size": 4,
    "num_workers": 3,
    "num_learners": 1,
    "backend": "nccl",
    "master_addr": "localhost",
    "master_port": "12355",
    "global_buffer_size": 8192,
    "local_buffer_size": 2048,
    "sync_interval": 100,
    "batch_size": 256,
    "gradient_accumulation": 4,
    "async_update": true,
    "dynamic_batching": true,
    "load_balancing": true
  },
  
  "network": {
    "type": "actor_critic",
    "use_attention": true,
    "attention_heads": 8,
    "dropout": 0.1
  },
  
  "optimization": {
    "lr_scheduler": "cosine",
    "warmup_steps": 1000,
    "weight_decay": 1e-5,
    "gradient_clipping": true,
    "early_stopping": {
      "enabled": true,
      "patience": 10,
      "min_delta": 0.001
    }
  },
  
  "evaluation": {
    "eval_episodes": 100,
    "eval_deterministic": true,
    "eval_opponents": ["random", "rule_based", "previous_best"],
    "tournament_size": 8
  },
  
  "logging": {
    "log_level": "INFO",
    "tensorboard": true,
    "wandb": false,
    "save_replay": true,
    "replay_buffer_size": 1000
  }
}